{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": [
    "sin1"
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "3d.froyek.com"
        }
      ],
      "destination": "https://3d.intero.id/:splat*",
      "permanent": true
    }
  ]
}
