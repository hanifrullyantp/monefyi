# Supabase CLI — salin ke .env (jangan commit .env)
#   cp .env.example .env
#
# Panduan lengkap: docs/SECRETS_WHERE_TO_PUT.md

# Deploy / link CLI — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_token_here

# Settings → General → Reference ID
SUPABASE_PROJECT_REF=zzwqfmdyncxbolestkqp

# Opsional: script ../scripts/verify-product-funnel.sh di laptop
# (Production Lynk tetap pakai Supabase Dashboard → Edge Function Secrets)
# LYNK_MERCHANT_KEY=

# Atau pisahkan Lynk ke file terpisah:
#   cp secrets.local.env.example secrets.local.env
#   source secrets.local.env
