{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/engine/tick", "schedule": "*/30 * * * *" },
    { "path": "/api/engine/review", "schedule": "0 */6 * * *" },
    { "path": "/api/engine/supervisor", "schedule": "*/15 * * * *" },
    { "path": "/api/engine/creatives", "schedule": "0 */6 * * *" }
  ]
}
